# Dados gerados a cada rodada do pipeline (nao sao codigo-fonte)
entrada/
historico/
alertas/
graficos/
.run_guard/
logs/

# Snapshot de dados consumido pelo dashboard (regenerado a cada rodada)
Dashboard Analise Funil/data/*.js

# Python
__pycache__/
*.pyc

# Excel lock files temporarios
~$*.xlsx

# Bilhete com a ultima base usada pelo fluxo principal (consumido pelo comparativo)
.ultima_base_funil.json

# Configuracao com segredos (webhook, IDs) - usar automacao_config.example.json como base
automacao_config.json

# Historico da xlsx de analise antiga (arquivo solto no repo)
historico/~$*.xlsx

# Arquivos de rascunho/teste
tmp_*.js
_teste_*

# Configuracao/sessao local do Claude Code
.claude/
